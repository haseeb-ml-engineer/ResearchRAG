# ============================================================================
# ResearchRAG — Environment Variable Template
# ============================================================================
# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before running the application.
# Variables marked [OPTIONAL] have sensible defaults defined in settings.py.
# ============================================================================


# ─── Application ────────────────────────────────────────────────────────────
# General application metadata and runtime mode.
# Prefix: APP_

# Human-readable application name. [OPTIONAL]
APP_NAME=ResearchRAG

# Current version (semantic versioning). [OPTIONAL]
APP_VERSION=0.1.0

# Deployment stage: development | staging | production. [OPTIONAL]
APP_ENVIRONMENT=development

# Enable verbose logging and developer-only behavior. [OPTIONAL]
APP_DEBUG=false


# ─── FastAPI / Uvicorn ──────────────────────────────────────────────────────
# Settings consumed by the Dockerfile and docker-compose.yml.

# Host address for the ASGI server. [OPTIONAL]
UVICORN_HOST=0.0.0.0

# Port the API listens on. [OPTIONAL]
UVICORN_PORT=8000

# Number of Uvicorn worker processes. [OPTIONAL]
UVICORN_WORKERS=2


# ─── Streamlit Frontend ────────────────────────────────────────────────────
# Settings consumed by the frontend container.

# Base URL the frontend uses to reach the API.
# In Docker Compose this is overridden to http://api:8000. [OPTIONAL]
API_URL=http://localhost:8000


# ─── LLM Providers ─────────────────────────────────────────────────────────
# Configuration for the generation (language model) stage.
# Prefix: LLM_

# LLM provider to use: openai | groq. [OPTIONAL]
LLM_PROVIDER=openai

# Model identifier for the chosen provider. [OPTIONAL]
LLM_MODEL=gpt-4o-mini

# Sampling temperature (0.0 = deterministic, 2.0 = maximum randomness). [OPTIONAL]
LLM_TEMPERATURE=0.2

# Maximum tokens the model may generate per response. [OPTIONAL]
LLM_MAX_TOKENS=1024


# ─── API Keys ──────────────────────────────────────────────────────────────
# External provider credentials.
# These have NO default values and must be set for their respective provider.

# [REQUIRED if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai]
OPENAI_API_KEY=your_openai_api_key_here

# [REQUIRED if LLM_PROVIDER=groq]
GROQ_API_KEY=your_groq_api_key_here


# ─── Embedding Models ──────────────────────────────────────────────────────
# Configuration for the embedding generation stage.
# Prefix: EMBEDDING_

# Embedding provider: sentence-transformers | openai. [OPTIONAL]
EMBEDDING_PROVIDER=sentence-transformers

# Model identifier (e.g., all-MiniLM-L6-v2 for local, text-embedding-3-small for OpenAI). [OPTIONAL]
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of text chunks embedded in a single batch. [OPTIONAL]
EMBEDDING_BATCH_SIZE=32


# ─── ChromaDB / Vector Store ───────────────────────────────────────────────
# Configuration for the vector database backend.
# Prefix: VECTOR_STORE_

# Vector database provider. [OPTIONAL]
VECTOR_STORE_PROVIDER=chromadb

# Name of the collection/index storing document embeddings. [OPTIONAL]
VECTOR_STORE_COLLECTION_NAME=research_documents


# ─── Chunking ──────────────────────────────────────────────────────────────
# Configuration for splitting documents into retrieval-sized units.
# Prefix: CHUNKING_

# Maximum number of characters per chunk. [OPTIONAL]
CHUNKING_CHUNK_SIZE=1000

# Number of overlapping characters between consecutive chunks. [OPTIONAL]
CHUNKING_CHUNK_OVERLAP=200


# ─── Retrieval Configuration ───────────────────────────────────────────────
# Configuration for query-time retrieval behaviour.
# Prefix: RETRIEVAL_

# Number of most relevant chunks to retrieve per query. [OPTIONAL]
RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0–1.0) a chunk must meet to be included. [OPTIONAL]
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# Cross-encoder model used for reranking. [OPTIONAL]
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of top chunks retained after reranking. [OPTIONAL]
RETRIEVAL_RERANKER_TOP_K=3


# ─── File Paths ─────────────────────────────────────────────────────────────
# Filesystem locations for data, persistence, and logs.
# Prefix: PATH_

# Root directory for all locally stored data. [OPTIONAL]
PATH_DATA_DIR=data

# Directory for unprocessed source documents. [OPTIONAL]
PATH_RAW_DOCUMENTS_DIR=data/raw

# Directory for cleaned and chunked document artifacts. [OPTIONAL]
PATH_PROCESSED_DOCUMENTS_DIR=data/processed

# Directory where the persisted vector database is stored. [OPTIONAL]
PATH_VECTOR_DB_DIR=data/vectorstore

# Directory where application log files are written. [OPTIONAL]
PATH_LOGS_DIR=logs
